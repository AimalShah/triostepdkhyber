---
import ProductCard from './ProductCard.astro';
import NewArrivalsMobileSwiper from './NewArrivalsMobileSwiper.astro';

import { PRODUCTS } from '../../data/shop.products';
import { fmtPrice } from '../../components/shop/ui/ShopAtoms';

// Select top 8 featured new arrivals
const featuredProducts = PRODUCTS.slice(0, 8);
---

<!-- BEGIN: New Arrivals -->
<section id="new-arrivals" data-animate-section class="w-full bg-[#FAFAFA] py-16 sm:py-24 md:py-32 overflow-hidden scroll-mt-24">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6">
        
        {/* Section Header */}
        <div class="text-center mb-10 md:mb-16">
            <div class="inline-flex items-center gap-2 mb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.35em] text-gray-400 font-black">Just Landed In Atelier</span>
            </div>
            <h2 class="font-display text-3xl sm:text-5xl md:text-7xl font-bold uppercase tracking-tight sm:tracking-tighter text-dark mb-4 gsap-reveal">
                New <span class="text-gray-400">Arrivals</span>
            </h2>
            <p class="text-xs md:text-sm text-gray-500 max-w-xl mx-auto font-medium tracking-wide px-2 gsap-reveal">
                Hand-welted Khyber craftsmanship in full-grain Italian & vegetable-tanned leathers, sculpted for timeless modern presence.
            </p>
            
            {/* Interactive Category Filter Tabs - Horizontally scrollable on mobile */}
            <div class="flex overflow-x-auto no-scrollbar py-2 px-1 gap-4 sm:gap-8 md:gap-10 mt-8 sm:mt-10 sm:justify-center justify-start border-b border-gray-200/50 sm:border-none select-none" id="arrivals-filter-tabs">
                <button 
                    data-filter="all" 
                    class="filter-tab-btn active text-[10px] sm:text-[10.5px] uppercase tracking-[0.2em] sm:tracking-[0.25em] font-black transition-all border-b-2 pb-2 border-dark text-dark cursor-pointer shrink-0"
                >
                    All Silhouettes
                </button>
                <button 
                    data-filter="Chelsea Boots" 
                    class="filter-tab-btn text-[10px] sm:text-[10.5px] uppercase tracking-[0.2em] sm:tracking-[0.25em] font-black transition-all border-b-2 pb-2 border-transparent text-gray-400 hover:text-dark cursor-pointer shrink-0"
                >
                    Chelsea Boots
                </button>
                <button 
                    data-filter="Ankle Boots" 
                    class="filter-tab-btn text-[10px] sm:text-[10.5px] uppercase tracking-[0.2em] sm:tracking-[0.25em] font-black transition-all border-b-2 pb-2 border-transparent text-gray-400 hover:text-dark cursor-pointer shrink-0"
                >
                    Ankle Boots
                </button>
                <button 
                    data-filter="Derby Shoes" 
                    class="filter-tab-btn text-[10px] sm:text-[10.5px] uppercase tracking-[0.2em] sm:tracking-[0.25em] font-black transition-all border-b-2 pb-2 border-transparent text-gray-400 hover:text-dark cursor-pointer shrink-0"
                >
                    Derby Shoes
                </button>
                <button 
                    data-filter="Loafers" 
                    class="filter-tab-btn text-[10px] sm:text-[10.5px] uppercase tracking-[0.2em] sm:tracking-[0.25em] font-black transition-all border-b-2 pb-2 border-transparent text-gray-400 hover:text-dark cursor-pointer shrink-0"
                >
                    Loafers
                </button>
            </div>
        </div>

        {/* Mobile View */}
        <div class="block md:hidden">
            <NewArrivalsMobileSwiper products={PRODUCTS} />
        </div>

        {/* Desktop Grid - Refined Spacing with Rich Cards */}
        <div class="hidden md:grid md:grid-cols-4 gap-6 lg:gap-8 gsap-reveal-grid" id="arrivals-products-grid">
            {
                PRODUCTS.slice(0, 12).map((product) => (
                    <div 
                        class="gsap-product-card transition-all duration-300"
                        data-category={product.category}
                    >
                        <ProductCard
                            id={product.id}
                            title={product.name}
                            priceLabel={fmtPrice(product.price)}
                            originalPriceLabel={product.originalPrice > product.price ? fmtPrice(product.originalPrice) : undefined}
                            imageSrc={product.image}
                            imageAlt={product.name}
                            category={product.category}
                            color={product.color}
                            rating={product.rating}
                            reviews={product.reviews}
                            badge={product.badge}
                            inStock={product.inStock}
                        />
                    </div>
                ))
            }
        </div>

        {/* Bottom Action */}
        <div class="mt-16 md:mt-24 text-center gsap-reveal">
            <a href="/shop" class="inline-flex items-center gap-4 group">
                <span class="text-[11px] uppercase tracking-[0.4em] font-black text-dark group-hover:text-gray-500 transition-colors">
                    Explore Full 39-Pair Catalog
                </span>
                <div class="w-12 h-px bg-dark group-hover:w-20 transition-all duration-300 group-hover:bg-gray-400"></div>
                <span class="text-sm group-hover:translate-x-2 transition-transform duration-300">→</span>
            </a>
        </div>
    </div>
</section>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initNewArrivals() {
        const reveals = document.querySelectorAll('#new-arrivals .gsap-reveal');
        reveals.forEach((el) => {
            gsap.fromTo(el, 
                { y: 30, opacity: 0 },
                { 
                    y: 0, 
                    opacity: 1, 
                    duration: 1, 
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 90%",
                        toggleActions: "play none none reverse"
                    }
                }
            );
        });

        // Staggered grid reveal
        gsap.fromTo("#new-arrivals .gsap-product-card", 
            { y: 40, opacity: 0 },
            { 
                y: 0, 
                opacity: 1, 
                duration: 1, 
                stagger: 0.08, 
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#arrivals-products-grid",
                    start: "top 85%",
                }
            }
        );

        // Filter Tabs Logic
        const tabBtns = document.querySelectorAll('.filter-tab-btn');
        const cards = document.querySelectorAll('#arrivals-products-grid .gsap-product-card');

        tabBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                const target = btn.getAttribute('data-filter');

                // Update active state
                tabBtns.forEach(b => {
                    b.classList.remove('active', 'border-dark', 'text-dark');
                    b.classList.add('border-transparent', 'text-gray-400');
                });
                btn.classList.add('active', 'border-dark', 'text-dark');
                btn.classList.remove('border-transparent', 'text-gray-400');

                // Filter cards
                cards.forEach((cardEl) => {
                    const el = cardEl as HTMLElement;
                    const cat = el.getAttribute('data-category');
                    if (target === 'all' || cat === target) {
                        el.style.display = 'block';
                        gsap.fromTo(el, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" });
                    } else {
                        el.style.display = 'none';
                    }
                });
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initNewArrivals);
    document.addEventListener('astro:page-load', initNewArrivals);
</script>
<!-- END: New Arrivals -->
