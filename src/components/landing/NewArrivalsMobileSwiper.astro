---
import WishlistToggle from "../shop/ui/WishlistToggle";

import type { Product } from "../../data/shop.products";
import { fmtPrice } from "../../components/shop/ui/ShopAtoms";

interface Props {
    products: Product[];
}

const { products } = Astro.props;
---

<div
    class="md:hidden w-full overflow-hidden pb-4 pt-2 bg-white border-y border-gray-200"
>
    <div
        id="new-arrivals-mobile-swiper"
        class="swiper new-arrivals-swiper w-full overflow-hidden"
    >
        <div class="swiper-wrapper">
            {
                products.slice(0, 8).map((product, idx) => (
                    <div
                        class:list={[
                            "swiper-slide !h-auto box-border",
                            idx % 2 === 0 ? "border-r border-gray-100" : "",
                        ]}
                    >
                        <div class="relative group flex flex-col w-full h-full p-3 sm:p-4 bg-white transition-all">
                            <div class="relative aspect-[4/5] overflow-hidden bg-[#F9F9F9] mb-3">
                                {product.badge && (
                                    <span class="absolute top-2 left-2 z-10 text-[7px] font-bold uppercase tracking-[0.2em] bg-dark text-white px-2 py-0.5 shadow-sm">
                                        {product.badge}
                                    </span>
                                )}
                                
                                {/* Wishlist Button: Always visible on mobile touch devices */}
                                <div class="absolute top-2 right-2 z-20 transition-all duration-300">
                                    <div class="w-7 h-7 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-sm">
                                        <WishlistToggle productId={product.id} client:load />
                                    </div>
                                </div>
                                
                                <a href={`/product/${product.id}`} class="block w-full h-full relative" aria-label={`View ${product.name}`}>
                                    <img class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-105" src={product.image} alt={product.name} loading="lazy" />
                                    <div class="absolute inset-0 bg-dark/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                </a>

                                <a href={`/product/${product.id}`} class="absolute bottom-0 left-0 right-0 p-2 z-20 block text-center no-underline">
                                    <div class="w-full bg-dark/95 text-white py-2 text-[8px] uppercase tracking-[0.2em] font-bold shadow-md">
                                      View Details
                                    </div>
                                </a>
                            </div>
                            
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-[8px] uppercase tracking-[0.2em] text-gray-400 font-bold truncate">{product.category}</span>
                                <div class="flex items-center gap-0.5 text-[8px] text-dark shrink-0">
                                    <span class="text-amber-500">★</span>
                                    <span class="font-bold">{product.rating.toFixed(1)}</span>
                                </div>
                            </div>
                            <h3 class="text-[11px] sm:text-[12px] font-bold tracking-tight text-dark mb-1.5 truncate">
                                <a href={`/product/${product.id}`} class="hover:text-gray-600 transition-colors">
                                    {product.name}
                                </a>
                            </h3>
                            <div class="flex items-baseline gap-1.5 mt-auto">
                                <span class="text-[12px] font-black tracking-tight text-dark">{fmtPrice(product.price)}</span>
                                {product.originalPrice > product.price && (
                                    <span class="text-[9px] text-gray-400 line-through">{fmtPrice(product.originalPrice)}</span>
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
        <div
            id="new-arrivals-swiper-pagination"
            class="swiper-pagination !relative !bottom-auto pt-4 pb-2 bg-white flex justify-center gap-1.5"
        >
        </div>
    </div>
</div>

<script>
    import Swiper from "swiper";
    import { Autoplay, Pagination } from "swiper/modules";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    import "swiper/css";
    import "swiper/css/pagination";

    function mountSwiper() {
        const root = document.getElementById("new-arrivals-mobile-swiper");
        const paginationEl = document.getElementById(
            "new-arrivals-swiper-pagination",
        );
        if (
            !root?.querySelector(".swiper-slide") ||
            !paginationEl ||
            root.dataset.swiperMounted === "true"
        )
            return;

        root.dataset.swiperMounted = "true";

        new Swiper(root, {
            modules: [Pagination, Autoplay],
            slidesPerView: 2,
            spaceBetween: 0,
            watchSlidesProgress: true,
            loop: true,
            speed: 650,
            pagination: {
                el: paginationEl,
                clickable: true,
            },
            autoplay: {
                delay: 3500,
                disableOnInteraction: false,
                pauseOnMouseEnter: true,
            },
        });

        ScrollTrigger.refresh();
    }

    if (document.readyState !== "loading") mountSwiper();
    document.addEventListener("DOMContentLoaded", mountSwiper);
    document.addEventListener("astro:page-load", mountSwiper);
</script>
