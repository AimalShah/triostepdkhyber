---
import WishlistToggle from '../shop/ui/WishlistToggle';

export interface Props {
	id: number;
	title: string;
	priceLabel: string;
	imageSrc: string;
	imageAlt: string;
	category?: string;
	color?: string;
	originalPriceLabel?: string;
	rating?: number;
	reviews?: number;
	badge?: string | null;
	inStock?: boolean;
	bottomBorderMd?: boolean;
}

const {
	id,
	title,
	priceLabel,
	imageSrc,
	imageAlt,
	category = 'Handcrafted Footwear',
	color = 'Black',
	originalPriceLabel,
	rating = 4.8,
	reviews = 24,
	badge,
	inStock = true,
} = Astro.props;

const COLOR_HEX: Record<string, string> = {
  Black: '#1a1a1a', Brown: '#7c4a19', Tan: '#d2a679',
  White: '#f0f0f0', Olive: '#6b7c3a', Grey: '#9ca3af',
};

const BADGE_COLOR: Record<string, string> = {
  Bestseller: '#1a1a1a', New: '#2563eb', Sale: '#dc2626', Hot: '#ea580c',
};

const fullStars = Math.round(rating);
---

<article class={`relative group flex flex-col w-full bg-white border border-gray-100 p-3 sm:p-4 hover:border-dark hover:shadow-xl transition-all duration-500 ease-out ${!inStock ? 'opacity-60' : ''}`}>
  {/* Image Container */}
  <div class="relative aspect-[4/5] overflow-hidden bg-[#F7F7F7] mb-4">
    {/* Badge Chip */}
    {badge && (
      <span 
        class="absolute top-3 left-3 z-10 text-[8px] sm:text-[9px] font-bold uppercase tracking-[0.2em] text-white px-2.5 py-1 shadow-sm"
        style={`background-color: ${BADGE_COLOR[badge] || '#1a1a1a'}`}
      >
        {badge}
      </span>
    )}

    {/* Wishlist Button - Top Right */}
    <div class="absolute top-3 right-3 z-20 transition-all duration-300 transform">
      <div class="w-8 h-8 rounded-full bg-white/85 backdrop-blur-md flex items-center justify-center shadow-sm hover:bg-white hover:scale-110 transition-all">
        <WishlistToggle productId={id} client:load />
      </div>
    </div>
    
    <a href={`/product/${id || 1}`} class="block w-full h-full relative group/img">
      <img
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
        class="w-full h-full object-cover transition-all duration-[1.5s] ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-108"
      />
      <div class="absolute inset-0 bg-dark/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

      {!inStock && (
        <div class="absolute inset-0 bg-white/60 backdrop-blur-[2px] flex items-center justify-center z-10">
          <span class="text-[9px] uppercase tracking-[0.3em] font-black text-dark bg-white px-3 py-1.5 border border-dark">
            Sold Out
          </span>
        </div>
      )}
    </a>

    {/* Quick View / Add Button on Hover */}
    <div class="absolute bottom-0 left-0 right-0 p-3 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out z-20 bg-white/95 backdrop-blur-md border-t border-gray-100">
      <a 
        href={`/product/${id || 1}`}
        class="block text-center w-full bg-dark text-white py-2.5 text-[9px] uppercase tracking-[0.25em] font-black hover:bg-black transition-all duration-200 shadow-md"
      >
        View Details +
      </a>
    </div>
  </div>

  {/* Information Section */}
  <div class="flex flex-col flex-1 justify-between px-1">
    <div>
      {/* Category & Rating */}
      <div class="flex items-center justify-between mb-1.5">
        <div class="flex items-center gap-1.5">
          <span
            class="w-2 h-2 rounded-full border border-gray-300 shrink-0"
            style={`background-color: ${COLOR_HEX[color] || '#1a1a1a'}`}
            title={color}
          ></span>
          <span class="text-[9px] uppercase tracking-[0.25em] text-gray-400 font-bold truncate">
            {category}
          </span>
        </div>

        {/* Stars */}
        <div class="flex items-center gap-1 text-[9px] text-dark font-medium">
          <span class="text-amber-500">★</span>
          <span class="font-bold">{rating.toFixed(1)}</span>
          <span class="text-gray-400 text-[8px]">({reviews})</span>
        </div>
      </div>

      {/* Product Name */}
      <a href={`/product/${id || 1}`} class="block group/link mb-2">
        <h3 class="text-sm font-bold tracking-tight text-dark group-hover/link:text-gray-500 transition-colors duration-300 line-clamp-1">
          {title}
        </h3>
      </a>
    </div>
    
    {/* Price & Stock info */}
    <div class="pt-2 border-t border-gray-100 flex items-center justify-between">
      <div class="flex items-baseline gap-2">
        <span class="text-sm font-black text-dark tracking-tight">{priceLabel}</span>
        {originalPriceLabel && (
          <span class="text-[10px] text-gray-400 line-through font-medium">
            {originalPriceLabel}
          </span>
        )}
      </div>

      <span class="text-[8px] uppercase tracking-widest text-emerald-700 font-bold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        In Stock
      </span>
    </div>
  </div>
</article>
