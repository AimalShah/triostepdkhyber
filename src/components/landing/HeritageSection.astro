---
import { HERITAGE_IMAGE_URL } from '../../data/products';
---

<!-- BEGIN: Featured Collection -->
<section data-animate-section class="w-full bg-white max-w-[1440px] mx-auto px-4 sm:px-6 py-14 sm:py-20 md:py-28 border-t border-gray-200">
	<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14 items-center">
		<div class="order-2 md:order-1 pr-0 md:pr-12 lg:pr-16">
			<div class="inline-flex items-center gap-2 mb-3">
				<span class="w-1.5 h-1.5 rounded-full bg-dark"></span>
				<span class="text-[9px] sm:text-[10px] uppercase tracking-[0.35em] text-gray-400 font-bold">Atelier Signature</span>
			</div>
			<h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold uppercase tracking-tight sm:tracking-tighter text-dark mb-4 sm:mb-6 leading-tight">
				The Heritage<br />Collection
			</h2>
			<p class="text-xs sm:text-sm text-gray-600 font-light leading-relaxed mb-6 sm:mb-8 max-w-md">
				Discover our signature line of handcrafted Chelsea boots. Made from premium Italian calfskin, each pair is designed
				for durability, ergonomic arch support, and timeless style. The cornerstone of a discerning wardrobe.
			</p>
			<a
				class="inline-block border border-dark px-8 py-3.5 text-xs uppercase tracking-[0.2em] font-bold hover:bg-dark hover:text-white transition-colors text-center w-full sm:w-auto"
				href="/collections"
			>
				Explore Collection →
			</a>
		</div>
		<div class="order-1 md:order-2 aspect-[4/5] bg-gray-100 overflow-hidden shadow-sm">
			<img
				class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
				src={HERITAGE_IMAGE_URL}
				alt="Heritage Collection Lifestyle"
				width={960}
				height={1200}
				loading="lazy"
			/>
		</div>
	</div>
</section>
<!-- END: Featured Collection -->
