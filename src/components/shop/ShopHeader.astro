---
import CartDrawer from '../shop/ui/CartDrawer';
import WishlistHeaderBtn from '../shop/ui/WishlistHeaderBtn';
import QuickSearchModal from '../shop/ui/QuickSearchModal';
import logoImg from "../../assets/images/1000151679.jpg.jpeg";

const navLinks = [
    { label: "Catalog",      href: "/shop" },
    { label: "Collections",  href: "/collections" },
    { label: "New Arrivals", href: "/#new-arrivals" },
    { label: "Reviews",      href: "/#reviews" },
    { label: "Our Story",    href: "/about" },
    { label: "Sale",         href: "/sale", isSale: true },
] as const;

const pathname = Astro.url.pathname;
---

<!-- BEGIN: Announcement Bar -->
<div class="w-full bg-dark text-white text-[9px] uppercase tracking-[0.25em] font-medium py-2 px-4 border-b border-white/10 z-[101] relative select-none">
    <div class="max-w-[1440px] mx-auto flex items-center justify-between">
        <div class="hidden md:flex items-center gap-2 text-gray-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Atelier Open · Khyber Heritage</span>
        </div>
        
        <div class="flex-1 text-center flex items-center justify-center gap-3 text-gray-300">
            <span class="font-bold text-white">COMPLIMENTARY EXPRESS DELIVERY OVER 25,000 RS</span>
            <span class="hidden sm:inline text-white/30">•</span>
            <span class="hidden sm:inline text-gray-400">14-DAY COMPLIMENTARY EXCHANGES</span>
        </div>

        <div class="hidden lg:flex items-center gap-4 text-gray-400 font-bold">
            <span class="text-white/80">PKR (Rs) · Pakistan</span>
            <span class="text-white/20">|</span>
            <a href="https://wa.me/923000000000" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                Concierge
            </a>
        </div>
    </div>
</div>
<!-- END: Announcement Bar -->

<!-- BEGIN: Shop Navigation -->
<header class="w-full bg-white/95 border-b border-gray-100 sticky top-0 z-[100] backdrop-blur-xl transition-all duration-300 shadow-[0_2px_20px_-10px_rgba(0,0,0,0.05)]">
    <div class="max-w-[1440px] mx-auto px-6 py-4 md:py-5 flex justify-between items-center gap-4">

        {/* Logo & Brand Identity */}
        <a class="shrink-0 flex items-center gap-3 relative z-[110] group" href="/">
            <img 
                src={logoImg.src} 
                alt="Triostepdekhyaber Emblem" 
                class="h-9 md:h-10 w-auto object-contain transition-transform duration-500 group-hover:scale-105" 
            />
            <div class="flex flex-col">
                <span class="font-display text-sm md:text-[15px] font-black uppercase tracking-[0.25em] text-dark leading-none group-hover:text-gray-600 transition-colors">
                    Triostepdekhyaber
                </span>
                <span class="text-[8px] uppercase tracking-[0.35em] text-gray-400 font-bold mt-1">
                    Handcrafted Atelier
                </span>
            </div>
        </a>

        {/* Desktop Nav - Centered Editorial Navigation */}
        <nav class="hidden lg:flex flex-1 justify-center gap-8 xl:gap-10 text-[10.5px] uppercase tracking-[0.25em] font-black text-dark">
            {navLinks.map(({ label, href, isSale }) => {
                const isActive = pathname === href;
                return (
                    <a
                        class={`hover:text-gray-500 transition-all duration-200 relative py-1 flex items-center gap-1.5 after:absolute after:bottom-0 after:left-0 after:h-[1.5px] after:bg-dark after:transition-all
                            ${isActive ? 'after:w-full text-dark' : 'after:w-0 hover:after:w-full text-gray-700'}`}
                        href={href}
                    >
                        {isSale && (
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                        )}
                        <span>{label}</span>
                    </a>
                );
            })}
        </nav>

        {/* Desktop Actions */}
        <div class="hidden md:flex items-center gap-3 lg:gap-5 shrink-0">
            {/* Quick Search Trigger */}
            <QuickSearchModal client:load />

            {/* Wishlist Live Button */}
            <div class="border-l border-gray-100 pl-3">
                <WishlistHeaderBtn client:load />
            </div>

            {/* Cart — live React island with portal drawer */}
            <div class="border-l border-gray-100 pl-3">
                <CartDrawer client:load />
            </div>
        </div>

        {/* Mobile Controls */}
        <div class="flex md:hidden items-center gap-2 relative z-[110]">
             <QuickSearchModal client:load />
             <WishlistHeaderBtn client:load />
             <CartDrawer client:load />
             <button id="shop-mobile-toggle" class="relative w-9 h-9 flex items-center justify-center p-2 group ml-1" aria-label="Toggle Menu">
                <div class="w-5 flex flex-col gap-1.5 transition-all duration-500">
                    <span id="shop-line-top" class="w-full h-[1.5px] bg-dark origin-center transition-all duration-500"></span>
                    <span id="shop-line-mid" class="w-full h-[1.5px] bg-dark transition-all duration-500"></span>
                    <span id="shop-line-bot" class="w-full h-[1.5px] bg-dark origin-center transition-all duration-500"></span>
                </div>
             </button>
        </div>
    </div>

    {/* Elite Mobile Menu Overlay */}
    <div id="shop-mobile-overlay" class="fixed inset-0 bg-white z-[105] shop-clip-hidden lg:hidden">
        <div class="h-full flex flex-col px-8 pt-24 pb-10 relative overflow-y-auto">
            {/* Header section in menu */}
            <div class="flex justify-between items-center mb-8 shop-mobile-link opacity-0">
                <span class="text-[10px] uppercase tracking-[0.4em] text-gray-400 font-black">Atelier Directory</span>
                <div class="h-px flex-1 bg-gray-100 mx-6"></div>
            </div>

            <nav class="flex flex-col relative z-10 flex-1">
                {
                    [
                        { label: "Full Catalog",  href: "/shop" },
                        { label: "Collections",   href: "/collections" },
                        { label: "New Arrivals",  href: "/#new-arrivals" },
                        { label: "Client Reviews",href: "/#reviews" },
                        { label: "Seasonal Sale", href: "/sale" },
                        { label: "Wishlist",      href: "/wishlist" },
                        { label: "Our Story",     href: "/about" }
                    ].map(({ label, href }) => (
                        <a
                            class="shop-mobile-link py-4 border-b border-gray-100 text-xl font-bold uppercase tracking-tight text-dark opacity-0 flex justify-between items-center group"
                            href={href}
                        >
                            <span>{label}</span>
                            <svg viewBox="0 0 24 24" class="w-4 h-4 text-gray-300 group-hover:text-dark transition-colors" fill="none" stroke="currentColor" strokeWidth="2">
                                <path d="M9 18l6-6-6-6" />
                            </svg>
                        </a>
                    ))
                }
            </nav>
            
            {/* Professional Footer Actions */}
            <div class="mt-8 relative z-10">
                <div class="grid grid-cols-2 gap-3 mb-6 shop-mobile-link opacity-0">
                    <a href="/shop" class="bg-gray-50 py-3.5 text-center text-[10px] uppercase tracking-[0.25em] font-black hover:bg-dark hover:text-white transition-all">Shop All</a>
                    <a href="/about" class="bg-gray-50 py-3.5 text-center text-[10px] uppercase tracking-[0.25em] font-black hover:bg-dark hover:text-white transition-all">Heritage</a>
                </div>
                
                <div class="flex flex-col gap-2 pt-4 border-t border-gray-100 shop-mobile-link opacity-0">
                    <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Atelier Inquiries & WhatsApp</p>
                    <a href="mailto:support@triostepdekhyaber.com" class="text-xs font-bold text-dark">support@triostepdekhyaber.com</a>
                    <p class="text-[10px] text-gray-400 mt-1">Delivery Nationwide Across Pakistan · Cash on Delivery & Card</p>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .shop-clip-hidden {
        clip-path: circle(0% at 90% 5%);
    }
</style>

<script>
    import gsap from 'gsap';

    function initShopMobileMenu() {
        const toggle = document.getElementById('shop-mobile-toggle');
        const overlay = document.getElementById('shop-mobile-overlay');
        const links = document.querySelectorAll('.shop-mobile-link');
        
        const lineTop = document.getElementById('shop-line-top');
        const lineMid = document.getElementById('shop-line-mid');
        const lineBot = document.getElementById('shop-line-bot');
        
        let isOpen = false;

        if (!toggle || !overlay) return;

        // Clone to clear any old listeners
        const newToggle = toggle.cloneNode(true);
        toggle.parentNode?.replaceChild(newToggle, toggle);

        newToggle.addEventListener('click', () => {
            isOpen = !isOpen;
            
            if (isOpen) {
                gsap.to(lineTop, { rotation: 45, y: 7.5, duration: 0.4, ease: "power3.inOut" });
                gsap.to(lineMid, { opacity: 0, scaleX: 0, duration: 0.2 });
                gsap.to(lineBot, { rotation: -45, y: -7.5, duration: 0.4, ease: "power3.inOut" });

                gsap.to(overlay, {
                    clipPath: "circle(150% at 90% 5%)",
                    duration: 0.9,
                    ease: "power3.inOut"
                });

                gsap.to(links, {
                    opacity: 1,
                    x: 0,
                    stagger: 0.06,
                    duration: 0.6,
                    delay: 0.3,
                    ease: "power3.out"
                });
            } else {
                gsap.to(lineTop, { rotation: 0, y: 0, duration: 0.4, ease: "power3.inOut" });
                gsap.to(lineMid, { opacity: 1, scaleX: 1, duration: 0.4 });
                gsap.to(lineBot, { rotation: 0, y: 0, duration: 0.4, ease: "power3.inOut" });

                gsap.to(overlay, {
                    clipPath: "circle(0% at 90% 5%)",
                    duration: 0.6,
                    ease: "power3.inOut"
                });

                gsap.to(links, {
                    opacity: 0,
                    x: -20,
                    duration: 0.2
                });
            }
        });
        
        gsap.set(links, { x: -20, opacity: 0 });
    }

    document.addEventListener('DOMContentLoaded', initShopMobileMenu);
    document.addEventListener('astro:page-load', initShopMobileMenu);
</script>
<!-- END: Shop Navigation -->
