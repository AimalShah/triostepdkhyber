---
import Layout from "../layouts/Layout.astro";
import { CATEGORIES, PRODUCTS } from "../data/shop.products";

// Silhouette narrative definitions
const categoryDetails: Record<string, { tagline: string; description: string }> = {
    'Chelsea Boots': {
        tagline: 'The Quintessential Silhouette',
        description: 'Clean contours, custom elasticated side gussets, and seamless almond-toe profiles crafted for versatile elegance.'
    },
    'Ankle Boots': {
        tagline: 'Rugged Elegance & Structure',
        description: 'Engineered with reinforced leather heel counters, storm welt stitching, and custom lug outsoles for superior durability.'
    },
    'Derby Shoes': {
        tagline: 'Formal Precision & Balance',
        description: 'Timeless open-lacing construction cut from hand-selected full-grain calfskins with hand-burnished finishes.'
    },
    'Loafers': {
        tagline: 'Effortless Continental Ease',
        description: 'Supple moccasin construction featuring hand-stitched aprons, glove-leather linings, and all-day cushioned insoles.'
    },
    'Sneakers': {
        tagline: 'Luxury Minimalist Athleticism',
        description: 'Low-profile vulcanized rubber cupsoles fused with premium nappa leather uppers for understated metropolitan wear.'
    }
};

// Map collections data
const collections = CATEGORIES.filter(c => c !== 'All').map((category, index) => {
    const categoryProducts = PRODUCTS.filter(p => p.category === category);
    const repProduct = categoryProducts[0] || PRODUCTS[0];
    const details = categoryDetails[category] || {
        tagline: 'Master Silhouettes',
        description: 'Handcrafted leather footwear engineered with surgical attention to pattern, fit, and materials.'
    };

    return {
        id: index + 1,
        name: category,
        tagline: details.tagline,
        description: details.description,
        image: repProduct.image,
        count: categoryProducts.length,
        priceFrom: Math.min(...categoryProducts.map(p => p.price))
    };
});
---

<Layout title="Master Collections | Triostepdekhyaber">
    <main class="bg-[#FCFCFC]">
        {/* Cinematic Editorial Hero Section */}
        <section class="relative w-full min-h-[75vh] md:min-h-[85vh] bg-dark flex flex-col justify-between overflow-hidden text-white pt-16 pb-12">
            {/* Background Video */}
            <div class="absolute inset-0 z-0 overflow-hidden">
                <video
                    id="collections-hero-video"
                    class="w-full h-full object-cover opacity-60 mix-blend-luminosity scale-105 transition-all duration-1000"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                >
                    <source src="/videos/Leather_boots_on_metallic_surface.mp4" type="video/mp4" />
                    <source src="/videos/Black_leather_boots_on_grass.mp4" type="video/mp4" />
                </video>
                {/* Gradient overlays for depth and legibility */}
                <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/60 to-dark/80"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,rgba(255,255,255,0.08)_0%,transparent_60%)]"></div>
            </div>

            {/* Top Bar / Navigation Pills in Hero */}
            <div class="relative z-10 max-w-[1440px] mx-auto px-6 w-full pt-6">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
                    <div class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-gray-300">
                            Curated Archive // Edition 2024
                        </span>
                    </div>

                    {/* Sound Toggle */}
                    <button
                        id="collections-sound-toggle"
                        aria-label="Toggle sound"
                        class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-[9px] uppercase tracking-widest text-gray-300 hover:text-white hover:border-white/50 transition-all duration-300"
                    >
                        <svg id="collections-sound-icon" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
                        </svg>
                        <span id="collections-sound-text">Sound: Off</span>
                    </button>
                </div>
            </div>

            {/* Center Content */}
            <div class="relative z-10 max-w-[1440px] mx-auto px-6 w-full my-auto py-12">
                <div class="max-w-4xl">
                    <span class="text-[10px] uppercase tracking-[0.6em] text-gray-400 font-black mb-4 block">
                        The Architectural Lineage
                    </span>
                    <h1 class="font-display text-5xl sm:text-7xl md:text-9xl font-bold uppercase tracking-tighter leading-[0.85] mb-8">
                        Master <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-200 to-gray-500">
                            Collections
                        </span>
                    </h1>
                    <p class="text-xs sm:text-sm font-light uppercase tracking-[0.25em] max-w-xl text-gray-300 leading-relaxed mb-10 border-l border-white/30 pl-6">
                        Five signature silhouettes forged from premium full-grain leather, hand-lasted by master cobblers to establish a dialogue between heritage permanence and modern minimalism.
                    </p>

                    {/* Category Quick Jump Pills */}
                    <div class="flex flex-wrap gap-2 pt-2">
                        {CATEGORIES.filter(c => c !== 'All').map(cat => (
                            <a
                                href={`/shop?category=${encodeURIComponent(cat)}`}
                                class="px-4 py-2 bg-white/10 hover:bg-white text-white hover:text-dark backdrop-blur-md border border-white/20 text-[10px] uppercase tracking-[0.25em] font-bold transition-all duration-300 transform hover:-translate-y-0.5"
                            >
                                {cat} →
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            {/* Bottom Meta Stats Bar */}
            <div class="relative z-10 max-w-[1440px] mx-auto px-6 w-full">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 border-t border-white/10 text-left">
                    <div>
                        <span class="block text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Silhouettes</span>
                        <strong class="text-lg md:text-xl font-bold tracking-tight text-white">05 Distinct Lines</strong>
                    </div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Materials</span>
                        <strong class="text-lg md:text-xl font-bold tracking-tight text-white">Full-Grain Calfskin</strong>
                    </div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Craftsmanship</span>
                        <strong class="text-lg md:text-xl font-bold tracking-tight text-white">Khyber Heritage</strong>
                    </div>
                    <div>
                        <span class="block text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Construction</span>
                        <strong class="text-lg md:text-xl font-bold tracking-tight text-white">Hand-Welted Soles</strong>
                    </div>
                </div>
            </div>
        </section>

        {/* Collections Showcase Grid */}
        <section class="max-w-[1440px] mx-auto px-6 py-24 md:py-32">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 pb-8 border-b border-gray-200">
                <div>
                    <span class="text-[9px] uppercase tracking-[0.4em] text-gray-400 font-black block mb-2">Portfolio</span>
                    <h2 class="text-3xl md:text-5xl font-bold uppercase tracking-tighter text-dark">
                        Featured Silhouettes
                    </h2>
                </div>
                <p class="text-xs uppercase tracking-[0.2em] text-gray-400 max-w-sm">
                    Select any series to explore individual articles, custom patinas, sizing options, and available colorways.
                </p>
            </div>

            {/* Alternating Architectural Cards */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
                {collections.map((col, index) => (
                    <a
                        href={`/shop?category=${encodeURIComponent(col.name)}`}
                        class="group block relative bg-white border border-gray-100 hover:border-dark transition-all duration-500 overflow-hidden shadow-sm hover:shadow-2xl"
                    >
                        {/* Image Canvas with Scale on Hover */}
                        <div class="aspect-[16/11] bg-[#F7F7F7] overflow-hidden relative">
                            <img 
                                src={col.image} 
                                alt={col.name} 
                                class="w-full h-full object-cover transition-transform duration-[1.8s] ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-108"
                            />
                            {/* Hover tint overlay */}
                            <div class="absolute inset-0 bg-dark/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                            {/* Floating series label */}
                            <div class="absolute top-5 left-5 z-10 bg-dark/90 backdrop-blur-md text-white text-[9px] font-bold uppercase tracking-[0.3em] px-3.5 py-1.5">
                                Series 0{col.id}
                            </div>

                            {/* Stock badge */}
                            <div class="absolute top-5 right-5 z-10 bg-white/90 backdrop-blur-md text-dark text-[9px] font-black uppercase tracking-[0.25em] px-3 py-1.5 shadow-sm">
                                {col.count} Articles
                            </div>
                        </div>

                        {/* Card Content */}
                        <div class="p-8 md:p-10 flex flex-col justify-between bg-white">
                            <div>
                                <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold block mb-2">
                                    {col.tagline}
                                </span>
                                <h3 class="text-2xl md:text-4xl font-bold uppercase tracking-tighter text-dark mb-4 group-hover:text-gray-600 transition-colors">
                                    {col.name}
                                </h3>
                                <p class="text-xs text-gray-500 leading-relaxed font-normal mb-8">
                                    {col.description}
                                </p>
                            </div>

                            <div class="flex items-center justify-between pt-6 border-t border-gray-100">
                                <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-gray-400">
                                    Starting from <strong class="text-dark font-black">{new Intl.NumberFormat('ru-RU').format(col.priceFrom)}Rs</strong>
                                </span>
                                <span class="text-[11px] uppercase tracking-[0.3em] font-black text-dark group-hover:translate-x-2 transition-transform flex items-center gap-2">
                                    Explore Series <span>→</span>
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        {/* Brand Statement Section */}
        <section class="bg-dark py-32 overflow-hidden relative text-white">
            <div class="max-w-[1440px] mx-auto px-6 relative z-10 text-center">
                <span class="text-[10px] uppercase tracking-[0.6em] text-gray-400 font-black mb-6 block">
                    Khyber Heritage · Contemporary Silhouette
                </span>
                <h2 class="text-white text-4xl sm:text-6xl md:text-7xl font-bold uppercase tracking-tighter leading-tight max-w-4xl mx-auto mb-10">
                    Handcrafted for the <br />
                    Modern <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-200 via-gray-400 to-gray-600 italic font-light">Minimalist</span>
                </h2>
                <p class="text-xs uppercase tracking-[0.25em] text-gray-400 max-w-lg mx-auto leading-relaxed mb-12">
                    Every stitch and cut honors generations of leather mastery, engineered to age gracefully with your personal journeys.
                </p>
                <div class="flex flex-wrap items-center justify-center gap-6">
                    <a
                        href="/shop"
                        class="inline-block bg-white text-dark px-12 py-5 text-[10px] uppercase tracking-[0.4em] font-black hover:bg-gray-200 transition-all duration-300 shadow-2xl hover:scale-105"
                    >
                        Browse All Articles
                    </a>
                    <a
                        href="/about"
                        class="inline-block border border-white/30 text-white px-10 py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-white hover:text-dark transition-all duration-300"
                    >
                        Read The Manifesto
                    </a>
                </div>
            </div>

            {/* Giant Watermark */}
            <div class="absolute inset-0 opacity-5 flex items-center justify-center pointer-events-none select-none">
                <span class="text-[22vw] font-black text-white uppercase tracking-tighter">
                    TRIOSTEP
                </span>
            </div>
        </section>
    </main>
</Layout>

<script>
    // Video Sound & Cycling Control
    const video = document.getElementById('collections-hero-video') as HTMLVideoElement | null;
    const soundToggle = document.getElementById('collections-sound-toggle');
    const soundIcon = document.getElementById('collections-sound-icon');
    const soundText = document.getElementById('collections-sound-text');

    const mutedSvg = `<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>`;
    const unmutedSvg = `<path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM3 9v6h4l5 5V4L7 9H3zm10-5.51v1.54C15.18 5.96 17 8.82 17 12s-1.82 6.04-4 6.97v1.54C16.25 19.38 19 16 19 12s-2.75-7.38-6-8.51z"/>`;

    if (soundToggle && video && soundIcon && soundText) {
        soundToggle.addEventListener('click', () => {
            video.muted = !video.muted;
            if (video.muted) {
                soundIcon.innerHTML = mutedSvg;
                soundText.textContent = 'Sound: Off';
            } else {
                soundIcon.innerHTML = unmutedSvg;
                soundText.textContent = 'Sound: On';
            }
        });
    }

    // Seamless loop alternation
    if (video) {
        const sources = [
            '/videos/Leather_boots_on_metallic_surface.mp4',
            '/videos/Black_leather_boots_on_grass.mp4'
        ];
        let currentIndex = 0;

        video.addEventListener('ended', () => {
            currentIndex = (currentIndex + 1) % sources.length;
            video.src = sources[currentIndex];
            video.load();
            video.play().catch(() => {/* handle autoplay restrictions */});
        });
    }
</script>
